<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_bg"
    android:fitsSystemWindows="true">

    <!-- Normal Browser Content UI -->
    <LinearLayout
        android:id="@+id/browserMainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Address Bar / Toolbar Container -->
        <LinearLayout
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/browser_toolbar_bg"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <!-- Home Button -->
            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                app:tint="@color/browser_text_secondary" />

            <!-- Floating Address Bar with Rounded Corners -->
            <LinearLayout
                android:id="@+id/omniboxContainer"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_omnibox"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- Security Lock / Search Indicator -->
                <ImageView
                    android:id="@+id/ivSecurityStatus"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Security Status"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/google_green" />

                <!-- URL / Search Input -->
                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_or_type_url"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/browser_text_primary"
                    android:textColorHint="@color/browser_text_secondary"
                    android:textSize="14sp" />

                <!-- Reload / Stop Button -->
                <ImageButton
                    android:id="@+id/btnReloadStop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reload"
                    android:padding="6dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/browser_text_secondary" />
            </LinearLayout>

            <!-- Incognito Badge & Exit Indicator -->
            <FrameLayout
                android:id="@+id/btnIncognitoIndicator"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_incognito_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/incognito_active_badge"
                        android:src="@drawable/ic_incognito"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Exit"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Google Profile Picture Icon -->
            <FrameLayout
                android:id="@+id/profileContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_profile_circle">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile"
                    android:padding="6dp"
                    android:src="@drawable/ic_account_circle" />

                <!-- Synced badge indicator dot -->
                <View
                    android:id="@+id/viewSyncStatusBadge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_profile_circle"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- 3-Dot Settings Menu Button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/browser_text_secondary" />
        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/pageProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progressBackgroundTint="@android:color/transparent"
            android:progressTint="@color/browser_primary"
            android:visibility="gone"
            tools:progress="65"
            tools:visibility="visible" />

        <!-- WebView and Home Tab (New Tab Page) Container -->
        <FrameLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Primary Web Page View -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/browser_bg" />

            <!-- Home Tab / New Tab Page (NTP) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/homeTabContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/browser_bg"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="48dp">

                    <!-- Brand / App Logo & Title Header -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="Anup Web Logo"
                            android:src="@drawable/ic_launcher_foreground" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Anup Web"
                            android:textColor="@color/browser_text_primary"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Fast • Modern • Private • Seamless Sync"
                        android:textColor="@color/browser_text_secondary"
                        android:textSize="12sp" />

                    <!-- Center Search Bar Card (Google Style) -->
                    <LinearLayout
                        android:id="@+id/cardNtpSearch"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_search_card"
                        android:clickable="true"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Search Icon"
                            android:src="@drawable/ic_shortcut_google" />

                        <TextView
                            android:id="@+id/tvNtpSearchHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/google_search_hint"
                            android:textColor="@color/browser_text_secondary"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Search"
                            android:src="@drawable/ic_search"
                            app:tint="@color/browser_primary" />
                    </LinearLayout>

                    <!-- Google Sync Prompt Pill (if not signed in) -->
                    <LinearLayout
                        android:id="@+id/pillSyncPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_omnibox"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Google"
                            android:src="@drawable/ic_shortcut_google" />

                        <TextView
                            android:id="@+id/tvSyncStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/account_not_signed_in"
                            android:textColor="@color/browser_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Section Header: Shortcuts -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/shortcuts_title"
                        android:textColor="@color/browser_text_secondary"
                        android:textSize="13sp" />

                    <!-- Shortcuts Grid: Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <!-- Shortcut 1: Google -->
                        <LinearLayout
                            android:id="@+id/shortcutGoogle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Google"
                                    android:src="@drawable/ic_shortcut_google" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Google"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Shortcut 2: YouTube -->
                        <LinearLayout
                            android:id="@+id/shortcutYoutube"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="YouTube"
                                    android:src="@drawable/ic_shortcut_youtube" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="YouTube"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Shortcut 3: Facebook -->
                        <LinearLayout
                            android:id="@+id/shortcutFacebook"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Facebook"
                                    android:src="@drawable/ic_shortcut_facebook" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Facebook"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Shortcut 4: Pinterest -->
                        <LinearLayout
                            android:id="@+id/shortcutPinterest"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Pinterest"
                                    android:src="@drawable/ic_shortcut_pinterest" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Pinterest"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Shortcuts Grid: Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <!-- Shortcut 5: Instagram -->
                        <LinearLayout
                            android:id="@+id/shortcutInstagram"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Instagram"
                                    android:src="@drawable/ic_shortcut_instagram" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Instagram"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Shortcut 6: GitHub -->
                        <LinearLayout
                            android:id="@+id/shortcutGithub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="GitHub"
                                    android:src="@drawable/ic_shortcut_github" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="GitHub"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Shortcut 7: Wikipedia -->
                        <LinearLayout
                            android:id="@+id/shortcutWikipedia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Wikipedia"
                                    android:src="@drawable/ic_shortcut_wikipedia" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Wikipedia"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Shortcut 8: Reddit -->
                        <LinearLayout
                            android:id="@+id/shortcutReddit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_shortcut_icon">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Reddit"
                                    android:src="@drawable/ic_shortcut_reddit" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Reddit"
                                android:textColor="@color/browser_text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <!-- Incognito Home Tab / Landing Screen -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/incognitoTabContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/incognito_bg"
                android:fillViewport="true"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="48dp">

                    <!-- Incognito Spy Icon -->
                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_profile_circle"
                        android:backgroundTint="@color/incognito_omnibox_bg">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="Incognito Icon"
                            android:src="@drawable/ic_incognito"
                            app:tint="@color/incognito_accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/incognito_title"
                        android:textColor="@color/incognito_text_primary"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/incognito_desc"
                        android:textColor="@color/incognito_text_secondary"
                        android:textSize="14sp" />

                    <!-- Incognito Info Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_incognito_card"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/incognito_wont_save"
                            android:textColor="@color/incognito_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/incognito_wont_save_history"
                            android:textColor="@color/incognito_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/incognito_wont_save_cookies"
                            android:textColor="@color/incognito_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/incognito_wont_save_forms"
                            android:textColor="@color/incognito_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Center Search Bar Card for Incognito -->
                    <LinearLayout
                        android:id="@+id/cardIncognitoSearch"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_incognito_search_card"
                        android:clickable="true"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Search Icon"
                            android:src="@drawable/ic_search"
                            app:tint="@color/incognito_accent" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="Search privately or enter URL"
                            android:textColor="@color/incognito_text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Exit Incognito Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitIncognitoLarge"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="24dp"
                        android:text="@string/exit_incognito"
